# ============================================================
# Variables de entorno - Chilaquiles Baja
# Copia este archivo a .env.local y llena los valores.
# NUNCA subas .env.local al repositorio.
# ============================================================

# --- Supabase (ya existentes) -------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key: Supabase > Settings > API > service_role.
# Sólo se usa en el servidor. Salta RLS, así que es la llave más sensible
# del proyecto: nunca la pongas en una variable NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=


# ============================================================
# INTEGRACIONES DE DELIVERY
# Guía completa en INTEGRACION_DELIVERY.md
# ============================================================

# --- Ajustes generales --------------------------------------
# Socio al que se atribuyen los ingresos sincronizados (UUID de Supabase Auth).
# Las ventas no cuentan como gasto de socio, así que no altera el reparto de
# utilidades. Si se deja vacío se usa el socio que presione "Sincronizar".
DELIVERY_SYNC_SOCIO_ID=

# Zona horaria del negocio y moneda usadas al agrupar por día.
DELIVERY_TIMEZONE=America/Tijuana
DELIVERY_MONEDA=MXN

# Token compartido para disparar la sincronización desde un cron externo
# (cabecera `x-cron-secret`). Genera uno largo y aleatorio.
DELIVERY_CRON_SECRET=


# --- Uber Eats ----------------------------------------------
# Se obtienen en https://developer.uber.com tras dar de alta la app y pedir
# acceso a las Marketplace APIs para tu tienda.
UBER_EATS_CLIENT_ID=
UBER_EATS_CLIENT_SECRET=

# UUID(s) de sucursal, separados por coma. Los da Uber al aprobar la app.
UBER_EATS_STORE_IDS=

# Secreto con el que Uber firma los webhooks. Si se deja vacío se usa el
# client secret, que es el comportamiento por defecto de Uber.
UBER_EATS_WEBHOOK_SECRET=

# --- Uber Eats: sólo si tu contrato usa otros valores ---------
# UBER_EATS_SCOPE="eats.report eats.store eats.order"
# UBER_EATS_TOKEN_URL=https://auth.uber.com/oauth/v2/token
# UBER_EATS_API_URL=https://api.uber.com
# UBER_EATS_REPORT_PATH=/v1/eats/report
# UBER_EATS_REPORT_TYPE=PAYMENT_DETAILS_REPORT


# --- Didi Food ----------------------------------------------
# Didi entrega estas credenciales al habilitar la Open API del comercio.
# No hay documentación pública: pídelas a tu ejecutivo de cuenta.
DIDI_FOOD_APP_ID=
DIDI_FOOD_APP_SECRET=

# Base de la API. Didi la asigna por región, por eso no tiene valor por defecto.
DIDI_FOOD_API_URL=

# ID(s) de sucursal, separados por coma.
DIDI_FOOD_STORE_IDS=

DIDI_FOOD_WEBHOOK_SECRET=

# --- Didi Food: sólo si tu contrato usa otros valores ---------
# DIDI_FOOD_TOKEN_URL=            # por defecto: <DIDI_FOOD_API_URL>/oauth/token
# DIDI_FOOD_ORDERS_PATH=/v1/order/list
# DIDI_FOOD_SIGN_ALGO=hmac-sha256 # o "md5"
# DIDI_FOOD_AMOUNTS_IN_CENTS=true # ponlo en false si tu API manda pesos
